  "quotes": [
    {
      "arm": "Agency",
      "category": "CPG operations",
      "text": "What's really important is to be able to look around corners and have an idea of what might be to come.",
      "speaker": "Todd Hoffman",
      "company": "Brightland",
      "title": "Chief Operating Officer",
      "podcast": "The Startup CPG Podcast",
      "episode": "Ops Spotlight: Todd Hoffman, COO at Brightland",
      "url": "https://startupcpg.transistor.fm/episodes/ops-spotlight-todd-hoffman-coo-brightland/transcript"
    },
    {
      "arm": "Agency",
      "category": "Packaging testing",
      "text": "They want packaging that they feel good about buying. They want to buy the product that makes them feel good as well.",
      "speaker": "Joel Fischer",
      "company": "AMETEK MOCON",
      "title": "CTS Scientist & Permeation Lab Manager",
      "podcast": "unPACKed with PMMI",
      "episode": "Testing the Limits of Sustainable Packaging: How to Build the Perfect Package",
      "url": "https://www.pmmi.org/podcast/testing-the-limits-of-sustainable-packaging-how-to-build-the-perfect-package"
    },
    {
      "arm": "Pac",
      "category": "Wine and spirits",
      "text": "Delivery's a nightmare. If you've got smart men and women around the table together to create packaging, they will not create a round glass bottle.",
      "speaker": "Santiago Navarro",
      "company": "Packamama",
      "title": "Founder",
      "podcast": "Dolia Talks",
      "episode": "The end of wine glass bottles, sustainability in the wine industry, and the future of wine e-commerce",
      "url": "https://getdolia.com/es/resources/podcasts/dolia-talks/episode-4"
    },
    {
      "arm": "Pac",
      "category": "Wine and spirits",
      "text": "What we see from the consumers is that they want to have a holistic experience.",
      "speaker": "Balaji Jayaseelan",
      "company": "Berlin Packaging",
      "title": "Vice President of Sustainability",
      "podcast": "Packaging Perspectives Podcast",
      "episode": "Sustainability in Spirits Packaging",
      "url": "https://www.packagingstrategies.com/articles/104327-podcast-sustainability-in-spirits-packaging"
    },
    {
      "arm": "Agency",
      "category": "Inventory planning",
      "text": "We were out of stock for at least six months out of those twelve months.",
      "speaker": "Hannah Perez",
      "company": "SEEQ",
      "title": "Co-Founder",
      "podcast": "The Startup CPG Podcast",
      "episode": "Founder Feature: Hannah Perez of SEEQ Supply",
      "url": "https://startupcpg.transistor.fm/episodes/founder-feature-hannah-perez-of-seeq-supply/transcript"
    },
    {
      "arm": "Agency",
      "category": "Operational ownership",
      "text": "If we're going to do that, this is what it's going to mean. Either this is the timeline... this is the cost.",
      "speaker": "Laura Romano",
      "company": "Graza",
      "title": "Director of Operations",
      "podcast": "The Startup CPG Podcast",
      "episode": "Ops Spotlight: Laura Romano of Graza",
      "url": "https://startupcpg.transistor.fm/episodes/ops-spotlight-laura-romano-of-graza/transcript"
    },
    {
      "arm": "Pac",
      "category": "Packaging change control",
      "text": "Constant pack changes every month or every quarter gets to be a lot to manage.",
      "speaker": "Matt Craighead",
      "company": "Trubar",
      "title": "R&D Manager",
      "podcast": "The Startup CPG Podcast",
      "episode": "Operator Spotlight: R&D Insights with Matt Craighead, R&D Manager Trubar",
      "url": "https://startupcpg.transistor.fm/episodes/operator-spotlight-r-d-insights-with-matt-craighead-r-d-manager-trubar/transcript"
    },
    {
      "arm": "Agency",
      "category": "Co-manufacturer selection",
      "text": "Lead times can really kill your schedule, kill your timeline, because it can vary.",
      "speaker": "Lance Schwarzkopf",
      "company": "Copack.net",
      "title": "Founder and Principal Consultant",
      "podcast": "The Startup CPG Podcast",
      "episode": "Finding Your Co-Man: Lance Schwarzkopf of Copack",
      "url": "https://startupcpg.transistor.fm/episodes/177-finding-your-co-man-lance-schwarzkopf-of-copack/transcript"
    },
    {
      "arm": "Pac",
      "category": "Sustainable packaging manufacturability",
      "text": "When you switch to a different material... getting that to seal properly on legacy equipment can be the challenge.",
      "speaker": "Greg Berguig",
      "company": "PAC Machinery",
      "title": "President",
      "podcast": "unPACKed with PMMI",
      "episode": "Bridging Marketing & Operations in the Sustainability Shift",
      "url": "https://www.pmmi.org/podcast/bridging-marketing-operations-in-the-sustainability-shift"
    },
    {
      "arm": "Agency",
      "category": "Consumer electronics retail",
      "text": "I became a very, very large retail buyer in the hardware space in Consumer Electronics where I saw the good, the bad, ugly how brands not just sell to retail, but also work with retailers.",
      "speaker": "Yohan Jacob",
      "company": "Retailbound",
      "title": "Founder and President",
      "podcast": "TRADEOFFS: The Hardware Startup Podcast",
      "episode": "T-25-006: Consumer Electronics Buyer to Retail Channel Product Launcher",
      "url": "https://tradeoffs.fm/6/transcript"
    },
    {
      "arm": "Pac",
      "category": "Luxury ecommerce",
      "text": "The packaging is the most direct communication that a brand's going to have to speak to that consumer besides the product itself.",
      "speaker": "Evelio Mattos",
      "company": "Design Packaging",
      "title": "Founder and Creative Director",
      "podcast": "A Branded World",
      "episode": "Delivering a Beautiful Experience with Evelio Mattos",
      "url": "https://marcastrategy.com/podcast_files/023/ABrandedWorld_023_ShowTranscript.pdf"
    },
    {
      "arm": "Agency",
      "category": "Beauty wholesale operations",
      "text": "The way we had to think about inventory planning and demand planning, radically different.",
      "speaker": "Sergio Tache",
      "company": "Dossier",
      "title": "Co-Founder",
      "podcast": "The Startup CPG Podcast",
      "episode": "How Dossier Disrupted the Fragrance Industry",
      "url": "https://startupcpg.transistor.fm/episodes/258-how-dossier-disrupted-the-fragrances-industry/transcript"
    },
    {
      "arm": "Pac",
      "category": "Fragrance packaging strategy",
      "text": "We use the same bottles, the same pumps, the same caps for all our SKUs. So that way you can order in bulk.",
      "speaker": "Sergio Tache",
      "company": "Dossier",
      "title": "Co-Founder",
      "podcast": "The Startup CPG Podcast",
      "episode": "How Dossier Disrupted the Fragrance Industry",
      "url": "https://startupcpg.transistor.fm/episodes/258-how-dossier-disrupted-the-fragrances-industry/transcript"
    },
    {
      "arm": "Agency",
      "category": "Consumer hardware operations",
      "text": "You need to commit to inventory and you need to be ordering your product to be produced six months to a year out.",
      "speaker": "Nate Kraft",
      "company": "Kraftful",
      "title": "Co-Founder and CEO",
      "podcast": "TRADEOFFS: The Hardware Startup Podcast",
      "episode": "Lessons from a Recovering Hardware Founder",
      "url": "https://tradeoffs.fm/14/transcript"
    },
    {
      "arm": "Agency",
      "category": "Supplier resilience",
      "text": "A hardware company can live or die based on supplier relationships.",
      "speaker": "Brian Chen",
      "company": "TechCompliance",
      "title": "Co-Founder and CEO",
      "podcast": "TRADEOFFS: The Hardware Startup Podcast",
      "episode": "Lessons from a Recovering Hardware Founder",
      "url": "https://tradeoffs.fm/14/transcript"
    },
    {
      "arm": "Pac",
      "category": "Circular wine and spirits packaging",
      "text": "The shift towards a circular economy necessitates behavioral changes at every stage of the supply chain.",
      "speaker": "Iain McPherson",
      "company": "ecoSPIRITS",
      "title": "Sales Director Europe Middle East and Africa",
      "podcast": "Green New Perspective",
      "episode": "ecoSPIRITS: Pioneering Sustainable Beverage Packaging Tech",
      "url": "https://www.npws.net/podcast/sustainable-spirits-technology"
    },
    {
      "arm": "Pac",
      "category": "Beauty packaging development",
      "text": "I would say that was by far the most expensive, most time consuming, and most challenging aspect of the brand.",
      "speaker": "Justin Wolff",
      "company": "Junk Theory",
      "title": "Co-Founder",
      "podcast": "The Startup CPG Podcast",
      "episode": "Founder Feature: Justin Wolff of Junk Theory",
      "url": "https://startupcpg.transistor.fm/episodes/founder-feature-justin-wolff-of-junk-theory/transcript"
    },
    {
      "arm": "Pac",
      "category": "Beauty claims and packaging",
      "text": "We intentionally list that percentage of those key skincare ingredients so that customers know that it's at an efficacious level.",
      "speaker": "Veena Krishnan",
      "company": "Daybird",
      "title": "Co-Founder",
      "podcast": "The Startup CPG Podcast",
      "episode": "Founder Feature: Veena Krishnan and Whitney McElwain of Daybird",
      "url": "https://startupcpg.transistor.fm/episodes/founder-feature-veena-krishnan-and-whitney-mcelwain-of-daybird/transcript"
    },
    {
      "arm": "Pac",
      "category": "Packaging iteration",
      "text": "We spent a lot of time. There are a lot of iterations, different ideas of stripes and the logo came from different people.",
      "speaker": "Liv Truesdell",
      "company": "FROST Buttercream",
      "title": "Founder",
      "podcast": "The Startup CPG Podcast",
      "episode": "Founder Feature: Liv Truesdell of FROST Buttercream",
      "url": "https://startupcpg.transistor.fm/episodes/founder-feature-liv-truesdell-of-frost-buttercream/transcript"
    },
    {
      "arm": "Pac",
      "category": "Retail packaging and rebranding",
      "text": "When you start in this business, if you're not coming from a CPG background, you don't know what you don't know. And we made a lot of assumptions about what good packaging was.",
